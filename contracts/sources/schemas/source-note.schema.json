{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "来源笔记",
  "description": "从来源中形成的摘录、摘要与研究记录；不是正式知识对象。",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid" },
    "source_id": { "$ref": "#/$defs/ulid" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "$ref": "#/$defs/language" },
    "review_status": { "enum": ["unreviewed", "reviewed"] },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "#/$defs/date" },
    "generated_by": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" }
  },
  "required": [
    "schema_version",
    "id",
    "source_id",
    "title",
    "language",
    "review_status",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
