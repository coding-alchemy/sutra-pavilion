{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "来源记录",
  "description": "一个可被准确引用的具体版次、版本或网页快照的唯一记录。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_role": {
      "enum": [
        "raw-material",
        "critical-edition",
        "scholarship",
        "institutional-overview",
        "discovery-clue"
      ]
    },
    "access_method": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "status": {
      "enum": [
        "available",
        "inaccessible",
        "withdrawn",
        "superseded"
      ]
    },
    "authors": {
      "$ref": "#/$defs/stringList"
    },
    "edition": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "published_date": {
      "$ref": "#/$defs/date"
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "family_id": {
      "$ref": "#/$defs/ulid"
    },
    "rights": {
      "type": "object",
      "properties": {
        "rights_statement": {
          "type": "string",
          "minLength": 1
        },
        "license_spdx": {
          "type": "string"
        },
        "reuse_scope": {
          "enum": [
            "redistributable",
            "noncommercial",
            "link-quote",
            "metadata-only",
            "permission-required",
            "restricted-cultural"
          ]
        },
        "access_status": {
          "enum": [
            "public",
            "restricted",
            "closed"
          ]
        },
        "community_protocol": {
          "type": "string",
          "minLength": 1
        },
        "consent_note": {
          "type": "string",
          "minLength": 1
        },
        "permission_basis": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_max_chars": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rights_statement",
        "reuse_scope",
        "access_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "reuse_scope": {
                "const": "restricted-cultural"
              }
            }
          },
          "then": {
            "required": [
              "community_protocol",
              "consent_note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reuse_scope": {
                "const": "link-quote"
              }
            }
          },
          "then": {
            "required": [
              "permission_basis",
              "excerpt_max_chars"
            ]
          }
        }
      ]
    },
    "acquisition": {
      "type": "object",
      "properties": {
        "acquired_date": {
          "$ref": "#/$defs/date"
        },
        "file_location": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "traceability": {
      "$ref": "#/$defs/rating"
    },
    "rigor": {
      "$ref": "#/$defs/rating"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "source_type",
    "source_role",
    "access_method",
    "language",
    "status",
    "rights"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "const": "book"
          }
        }
      },
      "then": {
        "required": [
          "edition",
          "publisher",
          "external_ids",
          "acquisition"
        ],
        "properties": {
          "external_ids": {
            "required": [
              "url"
            ]
          },
          "acquisition": {
            "required": [
              "acquired_date"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rated_by": {
          "type": "string",
          "minLength": 1
        },
        "rated_at": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
        "score",
        "reason",
        "rated_by",
        "rated_at"
      ],
      "additionalProperties": false
    }
  }
}
