{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "知识条目",
  "description": "可独立阅读和引用的知识内容对象，平铺于 libraries/<library>/entries/ 下。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "entry_type": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "summary": {
      "type": "string"
    },
    "aliases": {
      "$ref": "#/$defs/stringList"
    },
    "tags": {
      "$ref": "#/$defs/stringList"
    },
    "search_terms": {
      "$ref": "#/$defs/stringList"
    },
    "relations": {
      "$ref": "#/$defs/relations"
    },
    "attributes": {
      "type": "object"
    },
    "name_forms": {
      "$ref": "#/$defs/nameForms"
    },
    "verification_stage": {
      "enum": [
        "lead",
        "checked",
        "verified"
      ]
    },
    "controversy_status": {
      "enum": [
        "none",
        "disputed"
      ]
    },
    "publish_license": {
      "type": "string",
      "minLength": 1
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "slug",
    "entry_type",
    "language",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "$ref": "#/$defs/ulid"
          }
        },
        "required": [
          "type",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    "nameForms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "display": {
            "type": "boolean"
          },
          "usage": {
            "type": "string",
            "minLength": 1
          },
          "translated_as": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "id",
          "text",
          "language",
          "display"
        ],
        "additionalProperties": false
      }
    }
  }
}
