{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "知识库",
  "description": "隶属于知识域、围绕明确主题组织的条目集合，位于 libraries/<library>/_library.md。",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "$ref": "#/$defs/language" },
    "summary": { "type": "string" },
    "aliases": { "$ref": "#/$defs/stringList" },
    "relations": { "$ref": "#/$defs/relations" }
  },
  "required": ["schema_version", "id", "title", "language"],
  "additionalProperties": false,
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "target_id": { "$ref": "#/$defs/ulid" }
        },
        "required": ["type", "target_id"],
        "additionalProperties": false
      }
    }
  }
}
